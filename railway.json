{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "go build -o bin/api ./cmd/api && go build -o bin/worker ./cmd/worker",
    "watchPatterns": [
      "**/*.go",
      "go.mod",
      "go.sum"
    ]
  },
  "deploy": {
    "startCommand": "./start.sh",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
