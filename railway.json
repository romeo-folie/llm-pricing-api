{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "**/*.go",
      "go.mod",
      "go.sum",
      "nixpacks.toml",
      "railway.json",
      "start.sh",
      "migrations/**",
      "**/*.json"
    ]
  },
  "deploy": {
    "startCommand": "./start.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}