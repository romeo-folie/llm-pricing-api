# =============================================================================
# Database
# =============================================================================
# PostgreSQL + TimescaleDB connection string. Required — the API refuses to
# start without this.
# Local dev only — use sslmode=require for any external or production database.
DATABASE_URL=postgres://llmpricing:llmpricing@localhost:5434/llmpricing?sslmode=disable

# =============================================================================
# Redis
# =============================================================================
# Redis connection string used for response caching, rate limiting, and the
# asynq job queue.  Accepts the standard "host:port" form or a full
# "redis://" URL.  Defaults to localhost:6379 when not set.
REDIS_URL=localhost:6380

# =============================================================================
# Application
# =============================================================================
# Runtime environment.  Accepted values: development, staging, production.
# In non-development environments ADMIN_PASSWORD must be changed from the
# default; the API will refuse to start otherwise.
APP_ENV=development

# HTTP server listen port.  Defaults to 8080.
APP_PORT=8080

# Internal Prometheus metrics port.  Served on a separate listener that is never
# exposed publicly.  Defaults to 9091; set empty to disable.
#
# Both the API and the worker honour this variable.  Each Railway service sets
# its own value, but when running both locally the values must differ — the
# Makefile offsets the worker to 9092 for this reason.
METRICS_PORT=9091

# Minimum log level.  Accepted zerolog level names:
# trace, debug, info, warn, error, fatal, panic.  Defaults to "debug".
LOG_LEVEL=info

# =============================================================================
# Admin Basic Auth  (/admin/* endpoints)
# =============================================================================
# Username for the HTTP Basic Auth gate on /admin endpoints.
# Defaults to "admin".
ADMIN_USER=admin

# Password for the HTTP Basic Auth gate on /admin endpoints.
# REQUIRED to be non-default in staging/production environments.
# Default "changeme" is intentionally rejected at startup outside development.
ADMIN_PASSWORD=changeme

# =============================================================================
# Unkey API Key Authentication
# =============================================================================
# Server-side root key used to verify API keys via the Unkey SDK.
# Obtain from https://app.unkey.com/settings/root-keys
UNKEY_ROOT_KEY=your-unkey-root-key-here

# Unkey API namespace ID that scopes key verification to this project.
# Obtain from https://app.unkey.com/apis
UNKEY_API_ID=your-unkey-api-id-here

# =============================================================================
# Webhooks
# =============================================================================
# 32-byte hex-encoded AES-256-GCM key used to encrypt webhook secrets at rest.
# If left empty a random ephemeral key is generated at startup — webhook
# secrets will not survive process restarts.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET_KEY=

# =============================================================================
# OpenTelemetry (observability)
# =============================================================================
# OTLP gRPC endpoint for exporting traces.  Leave empty to use the no-op
# provider (no traces exported), which is safe for local development.
# Example for a local Jaeger instance: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name embedded in all trace spans and log records.
# Defaults to "llm-pricing-api".
OTEL_SERVICE_NAME=llm-pricing-api

# =============================================================================
# Grafana Cloud (observability backend)
# =============================================================================
# Two DIFFERENT token types are required and they are NOT interchangeable:
#
#   glc_…   access-policy token    → service endpoints (metrics/logs/traces writes)
#   glsa_…  service-account token  → the Grafana instance API (dashboards, alerts)
#
# An access-policy token is rejected by the instance API with
# "401 Invalid API key", which reads like a permissions problem but is a token
# *type* problem. The service-account token is created inside Grafana at
# <GRAFANA_API_URL>/org/serviceaccounts — not in the Cloud portal.

# --- Telemetry ingest (access-policy token) ---

# OTLP gateway base URL. The collector appends the signal path: /v1/traces now,
# /v1/logs with issue #199.
# Example: https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=

# Full Authorization header value for the OTLP gateway, including the "Basic "
# prefix. Contains the token — never commit a real value.
GRAFANA_CLOUD_BASIC_AUTH_HEADER=

# --- Metrics remote_write (same access-policy token) ---

# Prometheus remote_write endpoint. Find it under Connections → Data sources →
# your Prometheus datasource: the query URL is the same host with
# /api/prom instead of /api/prom/push.
# The hostname contains a shard number (e.g. prometheus-prod-65-…) that is only
# visible there; guessing it yields a Cloudflare 1016, which looks like the
# endpoint does not exist.
# Example: https://prometheus-prod-65-prod-eu-west-2.grafana.net/api/prom/push
GRAFANA_CLOUD_URL=

# Metrics instance ID. This is NOT the stack ID on the account page, and NOT the
# username used for OTLP — using the wrong one returns 401.
GRAFANA_CLOUD_USER=

# Access-policy token with the metrics:write scope (glc_…).
GRAFANA_CLOUD_API_KEY=

# --- Grafana instance API (service-account token) ---

# Grafana instance URL. Example: https://<stack>.grafana.net
GRAFANA_API_URL=

# Service-account token with the Admin role, granting dashboards + alerting
# provisioning. (glsa_…)
GRAFANA_API_TOKEN=

# --- Grafana Cloud Synthetic Monitoring (external uptime probes, #194) ---

# Region-specific SM API base. Find it in the Synthetic Monitoring app's config
# (`jsonData.apiHost`): GET <GRAFANA_API_URL>/api/plugins/grafana-synthetic-monitoring-app/settings
GRAFANA_SM_API_URL=

# SM access token, from the Synthetic Monitoring app: Config -> Access tokens.
# NOT GRAFANA_API_TOKEN — the instance service-account token is rejected by the
# SM API with `403 invalid API token`; the two are separate credential systems.
GRAFANA_SM_ACCESS_TOKEN=

# Hosted-graphs stack ID (the number in your <stack>.grafana.net URL). Used by
# the SM API when creating checks.
GRAFANA_SM_STACK_ID=
