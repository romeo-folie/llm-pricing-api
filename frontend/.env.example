# ─── Server-side (never exposed to client bundle) ──────────────────────────

# Base URL for the LLM Pricing API (Phase 2 REST API)
# Example: https://api.llmprice.dev
LLM_PRICING_API_BASE_URL=http://localhost:8080

# API key with Developer tier access (for /v1/models/:id/history and other Dev+ endpoints)
# Obtain from: https://llmprice.dev/pricing (Developer or Pro plan)
LLM_PRICING_API_KEY=

# ─── Client-side public values ──────────────────────────────────────────────

# Lemon Squeezy checkout URL for the Developer plan ($15/mo)
# Create at: https://app.lemonsqueezy.com > Products > Variants > Checkout URL
NEXT_PUBLIC_LS_CHECKOUT_DEV=

# Lemon Squeezy checkout URL for the Pro plan ($50/mo)
NEXT_PUBLIC_LS_CHECKOUT_PRO=

# Public canonical site URL (used for og:url and sitemap generation)
# Example: https://llmprice.dev
# WARNING: Always use https:// in staging and production — http:// will generate
# insecure OG/canonical URLs and trigger mixed-content warnings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to force the LottieFiles fallback hero instead of the GLB scene
# Useful in environments without WebGL support
NEXT_PUBLIC_USE_LOTTIE_HERO=false
