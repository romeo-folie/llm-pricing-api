{
  "title": "LLM Pricing Usage & Abuse",
  "uid": "llm-usage-abuse",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Requests by endpoint",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(llm_api_requests_total[5m])) by (path)" }]
    },
    {
      "id": 2,
      "title": "Per-key request rate",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(llm_api_requests_total[5m])) by (key_hash)" }]
    },
    {
      "id": 3,
      "title": "Keys above 50k/day (approx)",
      "type": "table",
      "targets": [{ "expr": "sum(increase(llm_api_requests_total[24h])) by (key_hash) > 50000" }]
    },
    {
      "id": 4,
      "title": "Rate-limit hits",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(llm_api_rate_limit_hits_total[5m])) by (tier)" }]
    }
  ]
}