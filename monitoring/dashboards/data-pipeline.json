{
  "title": "LLM Pricing Data Pipeline",
  "uid": "llm-data-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Scraper runs by source/status",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(llm_scraper_runs_total[5m])) by (source, status)" }]
    },
    {
      "id": 2,
      "title": "Reconciler events",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(llm_reconciler_events_total[5m])) by (event_type)" }]
    },
    {
      "id": 3,
      "title": "Webhook deliveries by status",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(llm_webhook_deliveries_total[5m])) by (status)" }]
    },
    {
      "id": 4,
      "title": "Time since last successful verification by source",
      "type": "timeseries",
      "targets": [
        {
          "expr": "time() - llm_source_last_success_timestamp_seconds",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Stale price ratio by source",
      "type": "timeseries",
      "targets": [
        {
          "expr": "llm_prices_stale_ratio",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Slug resolution outcomes",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(llm_slug_resolutions_total[1h])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Benchmark scrape runs by source/status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(llm_benchmark_scrape_runs_total[5m])) by (source, status)",
          "legendFormat": "{{source}} / {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Active benchmark evidence by benchmark",
      "type": "timeseries",
      "targets": [
        {
          "expr": "llm_benchmark_evidence_active",
          "legendFormat": "{{benchmark}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Stale benchmark evidence ratio by benchmark",
      "type": "timeseries",
      "targets": [
        {
          "expr": "llm_benchmark_evidence_stale_ratio",
          "legendFormat": "{{benchmark}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Capability recompute duration (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_capability_recompute_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 11,
      "title": "Capability recompute failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(llm_capability_recompute_failures_total[5m]))"
        }
      ]
    },
    {
      "id": 12,
      "title": "Job queue depth by state",
      "type": "timeseries",
      "targets": [
        {
          "expr": "llm_asynq_queue_tasks",
          "legendFormat": "{{queue}} / {{state}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Oldest pending job (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "llm_asynq_queue_latency_seconds",
          "legendFormat": "{{queue}}"
        }
      ]
    }
  ]
}