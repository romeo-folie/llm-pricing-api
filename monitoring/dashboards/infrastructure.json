{
  "title": "LLM Pricing Infrastructure",
  "uid": "llm-infrastructure",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Postgres active connections",
      "type": "timeseries",
      "targets": [{ "expr": "sum(pg_stat_activity_count)" }]
    },
    {
      "id": 2,
      "title": "Redis used memory",
      "type": "timeseries",
      "targets": [{ "expr": "redis_memory_used_bytes" }]
    },
    {
      "id": 3,
      "title": "Go goroutines",
      "type": "timeseries",
      "targets": [{ "expr": "go_goroutines" }]
    },
    {
      "id": 4,
      "title": "Go GC duration",
      "type": "timeseries",
      "targets": [{ "expr": "rate(go_gc_duration_seconds_sum[5m])" }]
    }
  ]
}